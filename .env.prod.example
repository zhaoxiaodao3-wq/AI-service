# ===== 生产环境变量模板（复制为 .env.prod 后修改）=====
# 放置位置：与 docker-compose.prod.yml 同目录

# 数据库
POSTGRES_DB=aigc
POSTGRES_USER=aigc
POSTGRES_PASSWORD=改成强密码
POSTGRES_PORT=5432

# 应用环境
APP_ENV=production

# 模型服务（同 backend/.env 的配置）
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4-flash
LLM_BASE_URL=
LLM_API_KEY=

# 向量模型（开发期用 local 免外部服务）
EMBEDDING_MODE=local

# 密钥
SECRET_KEY=改成随机长字符串
JWT_SECRET=改成随机长字符串

# 安全
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_PROVIDER=heuristic

# 可观测性
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=aigc-backend
