# 环境：development / production
APP_ENV=development
# 敏感字段加密密钥（Fernet key），生产环境必须更换
SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# PostgreSQL
POSTGRES_DB=aigc_chat
POSTGRES_USER=aigc_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Qdrant
QDRANT_PORT=6333

# LLM（阶段 0 只预留，不调用）
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROXY_BASE_URL=
LLM_PROXY_API_KEY=

# Embedding / RAG（阶段 3）；api=真实模型，local=开发期本地哈希向量
EMBEDDING_MODE=api
EMBEDDING_MODEL=embedding-2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.35
MEMORY_ENABLED=true
MEMORY_TOP_K=3
MEMORY_SCORE_THRESHOLD=0.35
LLM_RETRY_COUNT=1
RATE_LIMIT_PER_MINUTE=30
JWT_SECRET=dev-jwt-secret-change-me-please-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TOOLS_ENABLED=true
MAX_TOOL_ROUNDS=3
