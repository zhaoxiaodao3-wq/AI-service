# backend/.env 生产模板（仅列关键项，其余键参考 backend/.env.example 照抄）
# 推荐做法：直接把本地 backend/.env scp 上服务器复用（含真实 LLM/Embedding key）
APP_ENV=production

# 容器内网连接地址（保持默认，不要用 localhost）
DATABASE_URL=postgresql+psycopg://aigc_user:change_me_strong_password@postgres:5432/aigc_chat
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# 敏感密钥：生产必须更换（openssl rand -base64 32）
SECRET_KEY=
JWT_SECRET=

# LLM（示例：智谱 GLM）
LLM_PROVIDER=zhipu
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# Embedding / RAG
EMBEDDING_MODE=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
